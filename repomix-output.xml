                    <th className="px-6 py-3.5 text-left text-xs font-medium text-[#99A1AF]">
                      Date
                    </th>

                    <th className="px-6 py-3.5 text-left text-xs font-medium text-[#99A1AF]">
                      Score
                    </th>

                    <th className="px-6 py-3.5 text-left text-xs font-medium text-[#99A1AF]">
                      Pages
                    </th>

                    <th className="px-6 py-3.5 text-left text-xs font-medium text-[#99A1AF]">
                      Issues
                    </th>

                    <th className="px-6 py-3.5 text-left text-xs font-medium text-[#99A1AF]">
                      Status
                    </th>

                    <th className="px-6 py-3.5" />
                  </tr>
                </thead>

                <tbody>
                  {audits.map((audit) => (
                    <tr
                      key={audit.id}
                      className="border-b border-[#F3F4F6] last:border-b-0 hover:bg-[#FCFCFD]"
                    >
                      <td className="max-w-[270px] px-6 py-4">
